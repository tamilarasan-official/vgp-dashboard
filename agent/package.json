{
  "name": "vgp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "VGP on-site sync agent: reads Tally (read-only Export) and pushes to the VGP dashboard API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "once": "tsx src/index.ts --once",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
