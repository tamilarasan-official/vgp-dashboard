# Tally on this machine (installed on the Tally PC) or on the office network
TALLY_URL=http://localhost:9000
# Dashboard API (Dokploy URL in production)
API_URL=http://localhost:4000/api
AGENT_ID=vgp-office-agent
# Must match an entry in the backend's AGENT_TOKENS
AGENT_TOKEN=
INTERVAL_MINUTES=15
# IST hour after which the daily deleted-voucher check runs (Tally closes ~23:00)
FULL_CHECK_HOUR=22
# Optional: only these companies (separate with |). Empty = all open companies.
COMPANIES=
